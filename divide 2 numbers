class Solution:
    def divide(self, dividend: int, divisor: int) -> int:
        count =0 
        a=abs(dividend)
        b=abs(divisor)
        while a>=b:
            a=a-b
            count+=1
        max_int=2**31-1
        min_int=-2**31
        

        if count>max_int:
            return max_int

        if count<min_int:
            return min_int
        if (dividend<0) != (divisor<0):
            count=-count

        return count    
